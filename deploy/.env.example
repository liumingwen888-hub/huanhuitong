# ─── Full-stack local orchestration ───
# Copy to .env and fill in real values. Every variable marked
# "required" must be present or the stack refuses to start
# (fail-fast — no silent degradation).

# Postgres owner password (bootstrap role created by init scripts)
POSTGRES_OWNER_PASSWORD=change-me-required

# Secret REFERENCES (vault-style) — never put key material here.
# Format: vault:<name>  or  env:<VARIABLE_NAME>
DATABASE_URL_REF=env:DATABASE_URL
TELEGRAM_WEBHOOK_SECRET_REF=env:TELEGRAM_WEBHOOK_SECRET
INBOX_DIGEST_KEYRING_REF=env:INBOX_DIGEST_KEYRING

# Retention windows (seconds) — optional with defaults
INBOX_RETENTION_SECONDS=604800
TELEGRAM_RETRY_WINDOW_SECONDS=86400

# Observability — "disabled" for synthetic; "otlp" needs endpoint
OTEL_EXPORTER=disabled
OTEL_EXPORTER_OTLP_ENDPOINT=

# Port bindings
PLATFORM_PORT=3000
ADMIN_WEB_PORT=8080
